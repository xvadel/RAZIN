# RAZIN — Environment Variables
# Copy to .env and fill in your keys

# --- LLM Provider ---
# Pick one: "gemini" or "groq"
LLM_PROVIDER=gemini

GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Detection ---
# Path to YOLO weights (relative to project root)
MODEL_PATH=models/yolo11n.pt
# Detections below this confidence are auto-flagged for review
CONFIDENCE_THRESHOLD=0.5

# --- Database ---
DATABASE_PATH=data/razin.db

# --- File Storage ---
UPLOAD_DIR=data/uploads
FRAMES_DIR=data/frames
CROPS_DIR=data/crops
ANNOTATED_DIR=data/annotated

# --- Video ---
# Frames per second to extract from uploaded video
VIDEO_SAMPLE_FPS=2

# --- API Auth ---
# Simple API key for protecting endpoints (leave empty to disable)
API_KEY=

# --- Optional ---
TAVILY_API_KEY=
